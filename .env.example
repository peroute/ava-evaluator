# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your key.  .env is gitignored.
# ---------------------------------------------------------------------------

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Offline switches -------------------------------------------------------
# AVA_STUB_LLM=1   -> steps 3/4/6 return canned data, zero Gemini calls.
# AVA_STUB_EMBED=1 -> step 2/5 use a deterministic fake embedder, zero calls.
# Start with both ON so you can verify the plumbing before spending any quota.
AVA_STUB_LLM=1
AVA_STUB_EMBED=1

# --- Models -----------------------------------------------------------------
AVA_JUDGE_MODEL=gemini-3.8-flash
AVA_EMBED_MODEL=gemini-embedding-2
AVA_EMBED_DIM=768

# --- Database (docker compose Postgres) -------------------------------------
# Used by the `db` container when it is first created.
POSTGRES_USER=ava
POSTGRES_PASSWORD=ava
POSTGRES_DB=ava_eval
# Host port the database is published on. 5433 rather than 5432 so it cannot
# collide with a PostgreSQL installed directly on your machine. If you change
# it, change the port in both URLs below too.
AVA_DB_PORT=5433

# For running the CLI / pytest on your own machine against the compose database.
# Containers ignore DATABASE_URL from here: compose points them at host `db`.
# Use 127.0.0.1, not localhost: the database is published on IPv4 loopback
# only, and localhost tries IPv6 first, which stalls every connection.
DATABASE_URL=postgresql://ava:ava@127.0.0.1:5433/ava_eval
# pytest empties every table before each test -- this MUST be a separate
# database, and its name must end in _test.
AVA_TEST_DATABASE_URL=postgresql://ava:ava@127.0.0.1:5433/ava_eval_test

# Zone timestamps are displayed and returned in (API JSON, report, CLI). Stored
# values are absolute instants and never change. Use an IANA name, not a fixed
# offset, so daylight saving time is handled. pgAdmin/psql get the same default
# from migration 0002.
AVA_DISPLAY_TIMEZONE=America/Chicago

# --- Retrieval tuning (step 5 / step 6) -------------------------------------
AVA_TOP_K=5
AVA_RETRY_K_MULTIPLIER=3
AVA_MAX_WORKERS=4

# --- Knowledge base (step 2) ------------------------------------------------
# The .docx to index. Defaults to the generated sample KB
# (python scripts/make_sample_kb.py). Point it at TTU's document for real runs:
# AVA_KB_FILE=realdata/online.docx

# --- Chunking (step 2) ------------------------------------------------------
AVA_CHUNK_TARGET_CHARS=1200
AVA_CHUNK_OVERLAP_RATIO=0.15
